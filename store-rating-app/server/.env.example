# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://storeapp:CHANGE_ME@localhost:5432/store_rating?schema=public"

# Used only by automated tests (a separate, throw-away database!)
TEST_DATABASE_URL="postgresql://storeapp:CHANGE_ME@localhost:5432/store_rating_test?schema=public"

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="1d"

PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN="http://localhost:5173"
BCRYPT_ROUNDS=10

# First administrator, used ONLY by "npm run seed". Choose your own values.
# Name: 20-60 chars. Password: 8-16 chars, one uppercase letter, one special character.
ADMIN_NAME="System Administrator Account"
ADMIN_EMAIL="admin@example.com"
ADMIN_ADDRESS="Head Office, Example Street, Example City"
ADMIN_PASSWORD="CHANGE_ME"

# Optional: only for "npm run seed:demo" (development sample data). Same password rules.
DEMO_PASSWORD=""
